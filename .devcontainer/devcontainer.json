// Codespace for working on the extension itself. It builds the .vsix from this
// checkout and installs it, so the Codespace runs the code of the branch you opened.
{
	"name": "vstrudel (built from source)",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:24",
	"containerEnv": { "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0" },
	"postCreateCommand": "corepack enable && pnpm install --frozen-lockfile && pnpm package && cp vstrudel-*.vsix /tmp/vstrudel.vsix",
	// Installing needs a connected editor, so it runs on attach and not on create.
	"postAttachCommand": "code --install-extension /tmp/vstrudel.vsix --force"
}
