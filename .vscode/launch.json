{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run vstrudel on template/",
			"type": "extensionHost",
			"request": "launch",
			"args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/template"],
			"outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
			"preLaunchTask": "build"
		}
	]
}
