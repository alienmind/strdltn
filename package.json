{
	"name": "vstrudel",
	"displayName": "vstrudel",
	"description": "Strudel live coding inside VS Code: an editor for .strudel files with sound, visuals, samples and a snippet library",
	"version": "0.0.3",
	"private": true,
	"publisher": "vstrudel",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/alienmind/vstrudel"
	},
	"engines": {
		"vscode": "^1.95.0",
		"node": ">=24"
	},
	"categories": [
		"Programming Languages",
		"Other"
	],
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"main": "./dist/extension.cjs",
	"activationEvents": [],
	"contributes": {
		"languages": [
			{
				"id": "strudel",
				"aliases": [
					"Strudel"
				],
				"extensions": [
					".strudel"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "strudel",
				"scopeName": "source.strudel",
				"path": "./syntaxes/strudel.tmLanguage.json"
			}
		],
		"customEditors": [
			{
				"viewType": "vstrudel.editor",
				"displayName": "Strudel editor",
				"selector": [
					{
						"filenamePattern": "*.strudel"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "vstrudel.play",
				"title": "vstrudel: Play / Update",
				"icon": "$(play)"
			},
			{
				"command": "vstrudel.stop",
				"title": "vstrudel: Stop",
				"icon": "$(debug-stop)"
			},
			{
				"command": "vstrudel.toggleMode",
				"title": "vstrudel: Toggle Strudel editor / native editor",
				"icon": "$(arrow-swap)"
			},
			{
				"command": "vstrudel.openStage",
				"title": "vstrudel: Open stage",
				"icon": "$(open-preview)"
			},
			{
				"command": "vstrudel.previewSound",
				"title": "vstrudel: Preview sound",
				"icon": "$(play)"
			},
			{
				"command": "vstrudel.insertSound",
				"title": "vstrudel: Insert sound name at cursor",
				"icon": "$(insert)"
			},
			{
				"command": "vstrudel.copySoundName",
				"title": "vstrudel: Copy sound name",
				"icon": "$(copy)"
			},
			{
				"command": "vstrudel.refreshSounds",
				"title": "vstrudel: Refresh sounds",
				"icon": "$(refresh)"
			},
			{
				"command": "vstrudel.insertSnippet",
				"title": "vstrudel: Insert snippet at cursor",
				"icon": "$(insert)"
			},
			{
				"command": "vstrudel.openSnippet",
				"title": "vstrudel: Open snippet file",
				"icon": "$(go-to-file)"
			},
			{
				"command": "vstrudel.refreshSnippets",
				"title": "vstrudel: Refresh snippets",
				"icon": "$(refresh)"
			},
			{
				"command": "vstrudel.showVersion",
				"title": "vstrudel: Show version and build"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "vstrudel.play",
					"when": "activeCustomEditorId == vstrudel.editor || resourceExtname == .strudel",
					"group": "navigation@1"
				},
				{
					"command": "vstrudel.stop",
					"when": "activeCustomEditorId == vstrudel.editor || resourceExtname == .strudel",
					"group": "navigation@2"
				},
				{
					"command": "vstrudel.toggleMode",
					"when": "activeCustomEditorId == vstrudel.editor || resourceExtname == .strudel",
					"group": "navigation@3"
				}
			],
			"view/title": [
				{
					"command": "vstrudel.refreshSounds",
					"when": "view == vstrudel.sounds",
					"group": "navigation"
				},
				{
					"command": "vstrudel.refreshSnippets",
					"when": "view == vstrudel.snippets",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "vstrudel.insertSound",
					"when": "view == vstrudel.sounds && viewItem == sound",
					"group": "inline"
				},
				{
					"command": "vstrudel.copySoundName",
					"when": "view == vstrudel.sounds && viewItem == sound",
					"group": "vstrudel@1"
				},
				{
					"command": "vstrudel.openSnippet",
					"when": "view == vstrudel.snippets && viewItem == snippet",
					"group": "inline"
				}
			],
			"commandPalette": [
				{
					"command": "vstrudel.previewSound",
					"when": "false"
				},
				{
					"command": "vstrudel.insertSound",
					"when": "false"
				},
				{
					"command": "vstrudel.copySoundName",
					"when": "false"
				},
				{
					"command": "vstrudel.insertSnippet",
					"when": "false"
				},
				{
					"command": "vstrudel.openSnippet",
					"when": "false"
				}
			]
		},
		"keybindings": [
			{
				"command": "vstrudel.play",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "editorLangId == strudel && editorTextFocus"
			},
			{
				"command": "vstrudel.stop",
				"key": "ctrl+.",
				"mac": "cmd+.",
				"when": "activeCustomEditorId == vstrudel.editor || editorLangId == strudel"
			},
			{
				"command": "vstrudel.toggleMode",
				"key": "ctrl+alt+m",
				"mac": "cmd+alt+m",
				"when": "activeCustomEditorId == vstrudel.editor || editorLangId == strudel"
			}
		],
		"configuration": {
			"title": "vstrudel",
			"properties": {
				"vstrudel.samplesFolder": {
					"type": "string",
					"default": "samples",
					"description": "Workspace folder that holds your samples. Each subfolder becomes a sound name."
				},
				"vstrudel.libFolder": {
					"type": "string",
					"default": "lib",
					"description": "Workspace folder that holds reusable Strudel snippets."
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "vstrudel",
					"title": "vstrudel",
					"icon": "media/vstrudel.svg"
				}
			]
		},
		"views": {
			"vstrudel": [
				{
					"id": "vstrudel.sounds",
					"name": "Sounds"
				},
				{
					"id": "vstrudel.snippets",
					"name": "Snippets"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "vstrudel.sounds",
				"contents": "Open a .strudel file to load the sound list."
			},
			{
				"view": "vstrudel.snippets",
				"contents": "No snippets yet. Put .strudel files in a lib/ folder."
			}
		]
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"watch": "node scripts/build.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test:vscode": "node scripts/test-vscode.mjs",
		"smoke": "node scripts/build.mjs && node scripts/smoke/serve.mjs",
		"package": "node scripts/build.mjs --production && vsce package --no-dependencies",
		"promote": "node scripts/promote.mjs"
	},
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@strudel/codemirror": "1.3.0",
		"@strudel/core": "1.2.6",
		"@strudel/draw": "1.2.6",
		"@strudel/hydra": "1.2.6",
		"@strudel/mini": "1.2.6",
		"@strudel/soundfonts": "1.3.0",
		"@strudel/tonal": "1.2.6",
		"@strudel/transpiler": "1.2.6",
		"@strudel/webaudio": "1.3.0",
		"@types/node": "^24.0.0",
		"@types/vscode": "~1.95.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.1.1",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
