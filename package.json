{
	"name": "vstrudel",
	"displayName": "vstrudel",
	"description": "Strudel live coding inside VS Code: an editor for .strudel files with sound, visuals, samples and a snippet library",
	"version": "0.2.0",
	"private": true,
	"publisher": "vstrudel",
	"license": "AGPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "https://github.com/alienmind/vstrudel"
	},
	"engines": {
		"vscode": "^1.95.0",
		"node": ">=24"
	},
	"categories": [
		"Programming Languages",
		"Other"
	],
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"main": "./dist/extension.cjs",
	"activationEvents": [],
	"contributes": {
		"languages": [
			{
				"id": "strudel",
				"aliases": [
					"Strudel"
				],
				"extensions": [
					".strudel"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "strudel",
				"scopeName": "source.strudel",
				"path": "./syntaxes/strudel.tmLanguage.json"
			}
		],
		"customEditors": [
			{
				"viewType": "vstrudel.editor",
				"displayName": "Strudel editor",
				"selector": [
					{
						"filenamePattern": "*.strudel"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "vstrudel.play",
				"title": "vstrudel: Play / Update",
				"icon": "$(play)"
			},
			{
				"command": "vstrudel.stop",
				"title": "vstrudel: Stop",
				"icon": "$(debug-stop)"
			},
			{
				"command": "vstrudel.refreshFiles",
				"title": "vstrudel: Refresh files",
				"icon": "$(refresh)"
			},
			{
				"command": "vstrudel.stopAll",
				"title": "vstrudel: Stop all"
			},
			{
				"command": "vstrudel.togglePlay",
				"title": "vstrudel: Play / Stop"
			},
			{
				"command": "vstrudel.showPackCache",
				"title": "vstrudel: Show sample pack cache size"
			},
			{
				"command": "vstrudel.clearPackCache",
				"title": "vstrudel: Clear sample pack cache"
			},
			{
				"command": "vstrudel.toggleMode",
				"title": "vstrudel: Toggle Strudel editor / native editor",
				"icon": "$(arrow-swap)"
			},
			{
				"command": "vstrudel.openStage",
				"title": "vstrudel: Open stage",
				"icon": "$(open-preview)"
			},
			{
				"command": "vstrudel.previewSound",
				"title": "vstrudel: Play sound once",
				"icon": "$(play)"
			},
			{
				"command": "vstrudel.insertSound",
				"title": "vstrudel: Insert sound name at cursor",
				"icon": "$(insert)"
			},
			{
				"command": "vstrudel.copySoundName",
				"title": "vstrudel: Copy sound name",
				"icon": "$(copy)"
			},
			{
				"command": "vstrudel.refreshSounds",
				"title": "vstrudel: Refresh sounds",
				"icon": "$(refresh)"
			},
			{
				"command": "vstrudel.insertSnippet",
				"title": "vstrudel: Insert snippet at cursor",
				"icon": "$(insert)"
			},
			{
				"command": "vstrudel.openSnippet",
				"title": "vstrudel: Open snippet file",
				"icon": "$(go-to-file)"
			},
			{
				"command": "vstrudel.refreshSnippets",
				"title": "vstrudel: Refresh snippets",
				"icon": "$(refresh)"
			},
			{
				"command": "vstrudel.showVersion",
				"title": "vstrudel: Show version and build"
			},
			{
				"command": "vstrudel.clickSound",
				"title": "vstrudel: Preview sound on click",
				"icon": "$(insert)"
			},
			{
				"command": "vstrudel.insertBank",
				"title": "vstrudel: Insert .bank() at cursor",
				"icon": "$(insert)"
			},
			{
				"command": "vstrudel.enablePreview",
				"title": "Preview on click is OFF. Press to turn it on",
				"icon": "$(mute)"
			},
			{
				"command": "vstrudel.disablePreview",
				"title": "Preview on click is ON. Press to turn it off",
				"icon": "$(unmute)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "vstrudel.play",
					"when": "activeCustomEditorId == vstrudel.editor || resourceExtname == .strudel",
					"group": "navigation@1"
				},
				{
					"command": "vstrudel.stop",
					"when": "activeCustomEditorId == vstrudel.editor || resourceExtname == .strudel",
					"group": "navigation@2"
				},
				{
					"command": "vstrudel.toggleMode",
					"when": "activeCustomEditorId == vstrudel.editor || resourceExtname == .strudel",
					"group": "navigation@3"
				}
			],
			"view/title": [
				{
					"command": "vstrudel.disablePreview",
					"when": "view == vstrudel.sounds && vstrudel.previewSounds",
					"group": "navigation@1"
				},
				{
					"command": "vstrudel.enablePreview",
					"when": "view == vstrudel.sounds && !vstrudel.previewSounds",
					"group": "navigation@1"
				},
				{
					"command": "vstrudel.refreshSounds",
					"when": "view == vstrudel.sounds",
					"group": "navigation@2"
				},
				{
					"command": "vstrudel.refreshFiles",
					"when": "view == vstrudel.files",
					"group": "navigation"
				},
				{
					"command": "vstrudel.refreshSnippets",
					"when": "view == vstrudel.snippets",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "vstrudel.insertSound",
					"when": "view == vstrudel.sounds && viewItem == sound",
					"group": "inline@1"
				},
				{
					"command": "vstrudel.previewSound",
					"when": "view == vstrudel.sounds && viewItem == sound",
					"group": "inline@2"
				},
				{
					"command": "vstrudel.insertBank",
					"when": "view == vstrudel.sounds && viewItem == bank",
					"group": "inline"
				},
				{
					"command": "vstrudel.insertSnippet",
					"when": "view == vstrudel.snippets && viewItem == snippet",
					"group": "inline@1"
				},
				{
					"command": "vstrudel.openSnippet",
					"when": "view == vstrudel.snippets && viewItem == snippet",
					"group": "inline@2"
				},
				{
					"command": "vstrudel.copySoundName",
					"when": "view == vstrudel.sounds && viewItem == sound",
					"group": "vstrudel@1"
				}
			],
			"commandPalette": [
				{
					"command": "vstrudel.previewSound",
					"when": "false"
				},
				{
					"command": "vstrudel.insertSound",
					"when": "false"
				},
				{
					"command": "vstrudel.clickSound",
					"when": "false"
				},
				{
					"command": "vstrudel.insertBank",
					"when": "false"
				},
				{
					"command": "vstrudel.copySoundName",
					"when": "false"
				},
				{
					"command": "vstrudel.insertSnippet",
					"when": "false"
				},
				{
					"command": "vstrudel.openSnippet",
					"when": "false"
				},
				{
					"command": "vstrudel.enablePreview",
					"when": "false"
				},
				{
					"command": "vstrudel.disablePreview",
					"when": "false"
				}
			]
		},
		"keybindings": [
			{
				"command": "vstrudel.play",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "editorLangId == strudel && editorTextFocus"
			},
			{
				"command": "vstrudel.stop",
				"key": "ctrl+.",
				"mac": "cmd+.",
				"when": "activeCustomEditorId == vstrudel.editor || editorLangId == strudel"
			},
			{
				"command": "vstrudel.toggleMode",
				"key": "ctrl+alt+m",
				"mac": "cmd+alt+m",
				"when": "activeCustomEditorId == vstrudel.editor || editorLangId == strudel"
			}
		],
		"configuration": {
			"title": "vstrudel",
			"properties": {
				"vstrudel.samplesFolder": {
					"type": "string",
					"default": "samples",
					"description": "Workspace folder that holds your samples. Each subfolder becomes a sound name."
				},
				"vstrudel.libFolder": {
					"type": "string",
					"default": "lib",
					"description": "Workspace folder that holds reusable Strudel snippets."
				},
				"vstrudel.editor.theme": {
					"type": "string",
					"default": "strudelTheme",
					"enum": [
						"strudelTheme",
						"algoboy",
						"archBtw",
						"androidstudio",
						"atomone",
						"aura",
						"bbedit",
						"blackscreen",
						"bluescreen",
						"bluescreenlight",
						"CutiePi",
						"darcula",
						"dracula",
						"duotoneDark",
						"eclipse",
						"fruitDaw",
						"githubDark",
						"githubLight",
						"greenText",
						"gruvboxDark",
						"gruvboxLight",
						"sonicPink",
						"materialDark",
						"materialLight",
						"monokai",
						"noctisLilac",
						"nord",
						"redText",
						"solarizedDark",
						"solarizedLight",
						"sublime",
						"teletext",
						"tokyoNight",
						"tokyoNightDay",
						"tokyoNightStorm",
						"vscodeDark",
						"vscodeLight",
						"whitescreen",
						"xcodeLight"
					],
					"description": "Color theme of the Strudel editor and the stage. These are the themes of strudel.cc."
				},
				"vstrudel.editor.fontFamily": {
					"type": "string",
					"default": "",
					"description": "Font of the Strudel editor. Empty: the font of the VS Code editor (editor.fontFamily)."
				},
				"vstrudel.editor.fontSize": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "Font size of the Strudel editor in pixels. 0: the size of the VS Code editor (editor.fontSize)."
				},
				"vstrudel.stage.position": {
					"type": "string",
					"default": "below",
					"enum": ["below", "beside"],
					"enumDescriptions": ["Under the code, in a group of its own", "To the right of the code"],
					"description": "Where the stage opens when a song plays in the native editor. It can be dragged anywhere after that."
				},
				"vstrudel.remoteSamples.cache": {
					"type": "boolean",
					"default": true,
					"description": "Keep a copy of the remote samples a song loads (samples('github:user/repo'), samples('https://.../strudel.json'), or a map with such a base) in .vstrudel/cache of the workspace, so they play without the network."
				},
				"vstrudel.remoteSamples.maxFiles": {
					"type": "number",
					"default": 600,
					"description": "A remote sample pack with more files than this is not copied to the cache. It still plays from the network."
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "vstrudel",
					"title": "vstrudel",
					"icon": "media/vstrudel.svg"
				}
			]
		},
		"views": {
			"vstrudel": [
				{
					"id": "vstrudel.logo",
					"name": "vstrudel",
					"type": "webview",
					"initialSize": 1
				},
				{
					"id": "vstrudel.files",
					"name": "Files",
					"initialSize": 3
				},
				{
					"id": "vstrudel.sounds",
					"name": "Sounds",
					"initialSize": 4
				},
				{
					"id": "vstrudel.snippets",
					"name": "Snippets",
					"initialSize": 4
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "vstrudel.files",
				"contents": "No .strudel files in this folder yet."
			},
			{
				"view": "vstrudel.sounds",
				"contents": "Open a .strudel file to load the sound list."
			}
		]
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"watch": "node scripts/build.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test:vscode": "node scripts/test-vscode.mjs",
		"test:quick": "node scripts/test-vscode.mjs --quick",
		"smoke": "node scripts/build.mjs && node scripts/smoke/serve.mjs",
		"package": "node scripts/build.mjs --production && vsce package --no-dependencies",
		"promote": "node scripts/promote.mjs",
		"reference": "node scripts/build-reference.mjs",
		"tutorial": "node scripts/build-tutorial.mjs",
		"test:unit": "node --test \"src/**/*.test.ts\""
	},
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@strudel/codemirror": "1.3.0",
		"@strudel/core": "1.2.6",
		"@strudel/draw": "1.2.6",
		"@strudel/hydra": "1.2.6",
		"@strudel/mini": "1.2.6",
		"@strudel/reference": "1.2.2",
		"@strudel/soundfonts": "1.3.0",
		"@strudel/tonal": "1.2.6",
		"@strudel/transpiler": "1.2.6",
		"@strudel/webaudio": "1.3.0",
		"@types/node": "^24.0.0",
		"@types/vscode": "~1.95.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.1.1",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
