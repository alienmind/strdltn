{
	"name": "strdltn",
	"displayName": "[str]dltn Live[code]",
	"description": "Your IDE is your DAW. Strudel live coding inside VS Code: an editor for .strudel files with sound, visuals, samples and a snippet library",
	"version": "0.4.0",
	"private": true,
	"publisher": "strdltn",
	"license": "AGPL-3.0-or-later",
	"icon": "media/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/alienmind/strdltn"
	},
	"engines": {
		"vscode": "^1.95.0",
		"node": ">=24"
	},
	"categories": [
		"Programming Languages",
		"Other"
	],
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"main": "./dist/extension.cjs",
	"activationEvents": [],
	"contributes": {
		"languages": [
			{
				"id": "strudel",
				"aliases": [
					"Strudel"
				],
				"extensions": [
					".strudel"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "strudel",
				"scopeName": "source.strudel",
				"path": "./syntaxes/strudel.tmLanguage.json"
			}
		],
		"customEditors": [
			{
				"viewType": "strdltn.editor",
				"displayName": "Strudel editor",
				"selector": [
					{
						"filenamePattern": "*.strudel"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "strdltn.play",
				"title": "strdltn: Play / Update",
				"icon": {
					"light": "media/play.svg",
					"dark": "media/play.svg"
				}
			},
			{
				"command": "strdltn.stop",
				"title": "strdltn: Stop",
				"icon": {
					"light": "media/stop.svg",
					"dark": "media/stop.svg"
				}
			},
			{
				"command": "strdltn.record",
				"title": "strdltn: Record (on / off)"
			},
			{
				"command": "strdltn.render",
				"title": "strdltn: Render audio"
			},
			{
				"command": "strdltn.stopAll",
				"title": "strdltn: Stop all"
			},
			{
				"command": "strdltn.togglePlay",
				"title": "strdltn: Play / Stop"
			},
			{
				"command": "strdltn.showPackCache",
				"title": "strdltn: Show sample pack cache size"
			},
			{
				"command": "strdltn.clearPackCache",
				"title": "strdltn: Clear sample pack cache"
			},
			{
				"command": "strdltn.toggleMode",
				"title": "strdltn: Toggle Strudel editor / native editor",
				"icon": "$(arrow-swap)"
			},
			{
				"command": "strdltn.openShrubEditor",
				"title": "strdltn: Open SHRUB editor (experimental)",
				"icon": "$(beaker)"
			},
			{
				"command": "strdltn.openStage",
				"title": "strdltn: Open stage",
				"icon": "$(open-preview)"
			},
			{
				"command": "strdltn.previewSound",
				"title": "strdltn: Play sound once",
				"icon": "$(play)"
			},
			{
				"command": "strdltn.insertSound",
				"title": "strdltn: Insert sound name at cursor",
				"icon": "$(insert)"
			},
			{
				"command": "strdltn.insertSnippet",
				"title": "strdltn: Insert snippet at cursor",
				"icon": "$(insert)"
			},
			{
				"command": "strdltn.showVersion",
				"title": "strdltn: Show version and build"
			},
			{
				"command": "strdltn.focusSearch",
				"title": "strdltn: Search the Browser",
				"icon": "$(search)"
			},
			{
				"command": "strdltn.refreshBrowser",
				"title": "strdltn: Refresh the Browser",
				"icon": "$(refresh)"
			},
			{
				"command": "strdltn.mixer.float",
				"title": "strdltn: Float the Mixer in its own window",
				"icon": "$(window)"
			},
			{
				"command": "strdltn.mixer.dock",
				"title": "strdltn: Dock the Mixer in the panel",
				"icon": "$(layout-panel)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "strdltn.play",
					"when": "activeCustomEditorId == strdltn.editor || resourceExtname == .strudel",
					"group": "navigation@1"
				},
				{
					"command": "strdltn.stop",
					"when": "activeCustomEditorId == strdltn.editor || resourceExtname == .strudel",
					"group": "navigation@2"
				},
				{
					"command": "strdltn.toggleMode",
					"when": "activeCustomEditorId == strdltn.editor || resourceExtname == .strudel",
					"group": "navigation@3"
				},
				{
					"command": "strdltn.mixer.dock",
					"when": "activeWebviewPanelId == strdltn.mixerTab",
					"group": "navigation@1"
				}
			],
			"view/title": [
				{
					"command": "strdltn.refreshBrowser",
					"when": "view == strdltn.browser",
					"group": "navigation@2"
				},
				{
					"command": "strdltn.openShrubEditor",
					"when": "view == strdltn.browser && config.strdltn.experimental.shrubEditor",
					"group": "navigation@3"
				},
				{
					"command": "strdltn.mixer.float",
					"when": "view == strdltn.mixer",
					"group": "navigation@1"
				}
			],
			"commandPalette": [
				{
					"command": "strdltn.previewSound",
					"when": "false"
				},
				{
					"command": "strdltn.insertSound",
					"when": "false"
				},
				{
					"command": "strdltn.insertSnippet",
					"when": "false"
				},
				{
					"command": "strdltn.openShrubEditor",
					"when": "config.strdltn.experimental.shrubEditor"
				}
			]
		},
		"keybindings": [
			{
				"command": "strdltn.play",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "editorLangId == strudel && editorTextFocus"
			},
			{
				"command": "strdltn.stop",
				"key": "ctrl+.",
				"mac": "cmd+.",
				"when": "activeCustomEditorId == strdltn.editor || editorLangId == strudel"
			},
			{
				"command": "strdltn.toggleMode",
				"key": "ctrl+alt+m",
				"mac": "cmd+alt+m",
				"when": "activeCustomEditorId == strdltn.editor || editorLangId == strudel"
			},
			{
				"command": "strdltn.focusSearch",
				"key": "ctrl+alt+f",
				"mac": "cmd+alt+f"
			}
		],
		"configuration": {
			"title": "strdltn",
			"properties": {
				"strdltn.render.mp3Bitrate": {
					"type": "number",
					"enum": [128, 160, 192, 256, 320],
					"default": 320,
					"description": "Bitrate of the .mp3 that Render and Record write next to the song, in kbit/s. The .wav is always written too."
				},
				"strdltn.render.cycles": {
					"type": "number",
					"default": 16,
					"minimum": 1,
					"description": "How many cycles Render makes of a song that does not say. A song says it in its header: // @length 100"
				},
				"strdltn.samplesFolder": {
					"type": "string",
					"default": "samples",
					"description": "Workspace folder that holds your samples. Each subfolder becomes a sound name."
				},
				"strdltn.firmwareFolder": {
					"type": "string",
					"default": "firmware",
					"description": "Workspace folder that holds VIBE FM firmwares (.wasm) from thefirmwarehub.com. Each one plays as s(\"vibefm1:<id>\")."
				},
				"strdltn.experimental.shrubEditor": {
					"type": "boolean",
					"default": false,
					"description": "Experimental mockup: adds the command \"Open SHRUB editor\", which shows Xfer's SHRUB web editor (shrub.audio/editor) in a tab. It is a separate synth: not in the song's mix or tempo, and no MIDI inside VS Code."
				},
				"strdltn.libFolder": {
					"type": "string",
					"default": "lib",
					"description": "Workspace folder that holds reusable Strudel snippets."
				},
				"strdltn.editor.theme": {
					"type": "string",
					"default": "strudelTheme",
					"enum": [
						"strudelTheme",
						"algoboy",
						"archBtw",
						"androidstudio",
						"atomone",
						"aura",
						"bbedit",
						"blackscreen",
						"bluescreen",
						"bluescreenlight",
						"CutiePi",
						"darcula",
						"dracula",
						"duotoneDark",
						"eclipse",
						"fruitDaw",
						"githubDark",
						"githubLight",
						"greenText",
						"gruvboxDark",
						"gruvboxLight",
						"sonicPink",
						"materialDark",
						"materialLight",
						"monokai",
						"noctisLilac",
						"nord",
						"redText",
						"solarizedDark",
						"solarizedLight",
						"sublime",
						"teletext",
						"tokyoNight",
						"tokyoNightDay",
						"tokyoNightStorm",
						"vscodeDark",
						"vscodeLight",
						"whitescreen",
						"xcodeLight"
					],
					"description": "Color theme of the Strudel editor and the stage. These are the themes of strudel.cc."
				},
				"strdltn.editor.fontFamily": {
					"type": "string",
					"default": "",
					"description": "Font of the Strudel editor. Empty: the font of the VS Code editor (editor.fontFamily)."
				},
				"strdltn.editor.fontSize": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "Font size of the Strudel editor in pixels. 0: the size of the VS Code editor (editor.fontSize)."
				},
				"strdltn.stage.position": {
					"type": "string",
					"default": "below",
					"enum": [
						"below",
						"beside"
					],
					"enumDescriptions": [
						"Under the code, in a group of its own",
						"To the right of the code"
					],
					"description": "Where the stage opens when a song plays in the native editor. It can be dragged anywhere after that."
				},
				"strdltn.remoteSamples.cache": {
					"type": "boolean",
					"default": true,
					"description": "Keep a copy of the remote samples a song loads (samples('github:user/repo'), samples('https://.../strudel.json'), or a map with such a base) in .strdltn/cache of the workspace, so they play without the network."
				},
				"strdltn.remoteSamples.maxFiles": {
					"type": "number",
					"default": 600,
					"description": "A remote sample pack with more files than this is not copied to the cache. It still plays from the network."
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "strdltn",
					"title": "[str]dltn",
					"icon": "media/strdltn.svg"
				}
			],
			"panel": [
				{
					"id": "strdltn-mixer",
					"title": "Mixer",
					"icon": "media/strdltn.svg"
				},
				{
					"id": "strdltn-devices",
					"title": "Devices",
					"icon": "media/strdltn.svg"
				}
			]
		},
		"views": {
			"strdltn": [
				{
					"id": "strdltn.browser",
					"name": "Library",
					"type": "webview",
					"initialSize": 4
				},
				{
					"id": "strdltn.songs",
					"name": "Songs and Snippets",
					"type": "webview",
					"initialSize": 2
				},
				{
					"id": "strdltn.reference",
					"name": "Reference",
					"type": "webview",
					"initialSize": 2
				},
				{
					"id": "strdltn.results",
					"name": "Results",
					"type": "webview",
					"initialSize": 6
				}
			],
			"strdltn-mixer": [
				{
					"id": "strdltn.mixer",
					"name": "Mixer",
					"type": "webview",
					"when": "!strdltn.mixerFloating"
				}
			],
			"strdltn-devices": [
				{
					"id": "strdltn.devices",
					"name": "Devices",
					"type": "webview"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "strdltn.files",
				"contents": "No .strudel files in this folder yet."
			},
			{
				"view": "strdltn.sounds",
				"contents": "Open a .strudel file to load the sound list."
			}
		]
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"watch": "node scripts/build.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test:vscode": "node scripts/test-vscode.mjs",
		"test:quick": "node scripts/test-vscode.mjs --quick",
		"smoke": "node scripts/build.mjs && node scripts/smoke/serve.mjs",
		"package": "node scripts/build.mjs --production && vsce package --no-dependencies",
		"promote": "node scripts/promote.mjs",
		"reference": "node scripts/build-reference.mjs",
		"tutorial": "node scripts/build-tutorial.mjs",
		"test:unit": "node --test \"src/**/*.test.ts\""
	},
	"devDependencies": {
		"@breezystack/lamejs": "1.2.7",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@julusian/midi": "3.9.0",
		"@strudel/codemirror": "1.3.0",
		"@strudel/core": "1.2.6",
		"@strudel/draw": "1.2.6",
		"@strudel/hydra": "1.2.6",
		"@strudel/mini": "1.2.6",
		"@strudel/reference": "1.2.2",
		"@strudel/soundfonts": "1.3.0",
		"@strudel/tonal": "1.2.6",
		"@strudel/transpiler": "1.2.6",
		"@strudel/webaudio": "1.3.0",
		"@types/node": "^24.0.0",
		"@types/vscode": "~1.95.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.1.1",
		"acorn": "8.19.0",
		"esbuild": "^0.28.2",
		"fflate": "0.8.2",
		"typescript": "^7.0.2"
	}
}
