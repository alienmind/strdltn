{
	"name": "vstrudel",
	"displayName": "vstrudel",
	"description": "Strudel live coding inside VS Code: an editor for .strudel files with sound, visuals, samples and a snippet library",
	"version": "0.0.1",
	"private": true,
	"publisher": "vstrudel",
	"license": "AGPL-3.0-or-later",
	"engines": {
		"vscode": "^1.95.0",
		"node": ">=24"
	},
	"categories": [
		"Programming Languages",
		"Other"
	],
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"main": "./dist/extension.cjs",
	"activationEvents": [],
	"contributes": {
		"languages": [
			{
				"id": "strudel",
				"aliases": [
					"Strudel"
				],
				"extensions": [
					".strudel"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "strudel",
				"scopeName": "source.strudel",
				"path": "./syntaxes/strudel.tmLanguage.json"
			}
		],
		"customEditors": [
			{
				"viewType": "vstrudel.editor",
				"displayName": "Strudel editor",
				"selector": [
					{
						"filenamePattern": "*.strudel"
					}
				],
				"priority": "default"
			}
		],
		"commands": [
			{
				"command": "vstrudel.play",
				"title": "Strudel: Play / Update",
				"icon": "$(play)"
			},
			{
				"command": "vstrudel.stop",
				"title": "Strudel: Stop",
				"icon": "$(debug-stop)"
			},
			{
				"command": "vstrudel.toggleMode",
				"title": "Strudel: Toggle Strudel editor / native editor",
				"icon": "$(arrow-swap)"
			},
			{
				"command": "vstrudel.openStage",
				"title": "Strudel: Open stage",
				"icon": "$(open-preview)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "vstrudel.play",
					"when": "activeCustomEditorId == vstrudel.editor || resourceExtname == .strudel",
					"group": "navigation@1"
				},
				{
					"command": "vstrudel.stop",
					"when": "activeCustomEditorId == vstrudel.editor || resourceExtname == .strudel",
					"group": "navigation@2"
				},
				{
					"command": "vstrudel.toggleMode",
					"when": "activeCustomEditorId == vstrudel.editor || resourceExtname == .strudel",
					"group": "navigation@3"
				}
			]
		},
		"keybindings": [
			{
				"command": "vstrudel.play",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "editorLangId == strudel && editorTextFocus"
			},
			{
				"command": "vstrudel.stop",
				"key": "ctrl+.",
				"mac": "cmd+.",
				"when": "activeCustomEditorId == vstrudel.editor || editorLangId == strudel"
			},
			{
				"command": "vstrudel.toggleMode",
				"key": "ctrl+alt+m",
				"mac": "cmd+alt+m",
				"when": "activeCustomEditorId == vstrudel.editor || editorLangId == strudel"
			}
		],
		"configuration": {
			"title": "vstrudel",
			"properties": {
				"vstrudel.samplesFolder": {
					"type": "string",
					"default": "samples",
					"description": "Workspace folder that holds your samples. Each subfolder becomes a sound name."
				},
				"vstrudel.libFolder": {
					"type": "string",
					"default": "lib",
					"description": "Workspace folder that holds reusable Strudel snippets."
				}
			}
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"watch": "node scripts/build.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test:vscode": "node scripts/test-vscode.mjs",
		"smoke": "node scripts/build.mjs && node scripts/smoke/serve.mjs",
		"package": "node scripts/build.mjs --production && vsce package --no-dependencies"
	},
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@strudel/codemirror": "1.3.0",
		"@strudel/core": "1.2.6",
		"@strudel/draw": "1.2.6",
		"@strudel/hydra": "1.2.6",
		"@strudel/mini": "1.2.6",
		"@strudel/tonal": "1.2.6",
		"@strudel/transpiler": "1.2.6",
		"@strudel/webaudio": "1.3.0",
		"@types/node": "^24.0.0",
		"@types/vscode": "~1.95.0",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^4.1.1",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}
