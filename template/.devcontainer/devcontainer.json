// Codespace for writing music. It installs the released vstrudel extension.
{
	"name": "vstrudel template",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	// One command, on attach: installing needs a connected editor. It downloads the
	// .vsix only when it is not there yet, and keeps it in the home folder.
	"postAttachCommand": "bash -c 'f=$HOME/.vstrudel.vsix; [ -f $f ] || curl -fsSL -o $f https://github.com/alienmind/vstrudel/releases/latest/download/vstrudel.vsix; code --install-extension $f --force'"
}
