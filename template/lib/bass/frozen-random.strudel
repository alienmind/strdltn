// @title Random bass line that repeats
// @category bass
// @details Random notes from a scale, cut to sixteen steps and frozen with rib, so the same line
//   comes back every bar. Change the first number of rib for another line.
// @tags generative, acid
// @by alienmind
// @credits Switch Angel
n(irand(8).seg(16).rib(4, 1))
  .scale("c2:minor:pentatonic")
  .s("sawtooth")
  .lpf(400).lpenv(5).lpq(10)
  .clip(.8).gain(.6)
